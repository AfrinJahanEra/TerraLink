# SMTP (recommended): every TerraLink email is sent from this mailbox to any address.
# Used by the local server in `npm run dev` / `npm run preview`. No VITE_ prefix, so the
# password stays on this machine and is never sent to the browser.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=afrinjahanera03@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=TerraLink
SMTP_REPLY_TO=

# EmailJS (fallback, used only when SMTP is not set up):
# create a Gmail service and one template that accepts the variables
# to_name, to_email, subject, message, notification_type, task_id,
# task_title, site_name, assignee_name, due_date, and action_url.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Report email: use VITE_EMAILJS_TEMPLATE_REPORT_SUMMARY_ID for a template whose
#   To      = {{to_email}}
#   Subject = {{subject}}
#   Body    = HTML containing {{{message_html}}}   (three braces, so the table is not escaped)
#   Attachments > Variable attachment: parameter report_pdf, file name {{report_filename}}
# The PDF is about 10 KB, so a request stays well under the free plan's 50 KB limit.

# Optional per-notification templates; each falls back to VITE_EMAILJS_TEMPLATE_ID.
VITE_EMAILJS_TEMPLATE_TASK_ASSIGN_ID=
VITE_EMAILJS_TEMPLATE_OVER_BUDGET_ID=
VITE_EMAILJS_TEMPLATE_TASK_COMPLETE_ID=
VITE_EMAILJS_TEMPLATE_REPORT_SUMMARY_ID=
VITE_EMAILJS_REPLY_TO=

# Google Cloud Web OAuth client. Enable Calendar API and add
# http://localhost:5173 as an Authorized JavaScript origin.
# Without it, "Add to Google Calendar" opens a prefilled Google Calendar page instead.
VITE_GOOGLE_CLIENT_ID=
